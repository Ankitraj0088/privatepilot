{
  "manifest_version": 3,
  "name": "PrivatePilot",
  "version": "0.1.0",
  "description": "Privacy-first browser AI agent",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://privatepilot.onrender.com/*"
  ],
  "action": {
    "default_title": "PrivatePilot",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}